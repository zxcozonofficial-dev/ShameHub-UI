function Section:_row(title, height)
    self.Order = (self.Order or 0) + 2
    local row = new("Frame", { LayoutOrder = self.Order, Size = UDim2.new(1, 0, 0, height or 30), BackgroundTransparency = 1 }, self.Content)
    if title then text(row, title, { Size = UDim2.new(1, -65, 0, 30), TextSize = 17 }) end
    return row
end

function Section:_control(options, initial, normalize, render)
    local w = self.Window
    assert(not options.Flag or not w.Controls[options.Flag], "Duplicate ShameHub flag: " .. tostring(options.Flag))
    local value = normalize(initial)
    local control = {}
    function control:Get() return value end
    function control:Set(nextValue, silent)
        nextValue = normalize(nextValue)
        local changed = nextValue ~= value
        value = nextValue
        if options.Flag then w.Flags[options.Flag] = value end
        render(value)
        if changed and not silent then invoke(options.Callback, value) end
    end
    if options.Flag then w.Controls[options.Flag] = control end
    control:Set(value, true)
    return control
end

function Section:AddParagraph(title, body)
    self.Order = (self.Order or 0) + 2
    local row = new("Frame", { LayoutOrder = self.Order, Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, BackgroundTransparency = 1 }, self.Content)
    list(row, 4)
    local heading = text(row, title, { Size = UDim2.new(1, 0, 0, 18), TextSize = 17 })
    local label = text(row, body, { Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, TextWrapped = true, TextSize = 17, TextColor3 = self.Window.Theme.Muted })
    return { Set = function(_, nextTitle, nextBody) heading.Text, label.Text = tostring(nextTitle), tostring(nextBody) end }
end

function Section:AddToggle(options)
    local w, t = self.Window, self.Window.Theme
    local row = self:_row(options.Title or "Toggle")
    local button = w:_button(row, "", { AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, 0, 0.5, 0), Size = UDim2.fromOffset(32, 17) })
    button:FindFirstChildOfClass("UICorner").CornerRadius = UDim.new(0.5, 0)
    local knob = new("Frame", { AnchorPoint = Vector2.new(0, 0.5), Size = UDim2.fromOffset(11, 11), Position = UDim2.new(0, 3, 0.5, 0), BackgroundColor3 = t.Muted }, button)
    corner(knob, 20)
    local control = self:_control(options, options.Default == true, function(v) assert(type(v) == "boolean", "Toggle expects boolean"); return v end, function(value)
        button.BackgroundColor3 = value and t.Accent or t.Raised
        tween(knob, { Position = UDim2.new(0, value and 18 or 3, 0.5, 0), BackgroundColor3 = value and t.Text or t.Muted })
    end)
    w:_accent(button, "BackgroundColor3", function() return control:Get() and t.Accent or t.Raised end)
    w:_connect(button.Activated, function() control:Set(not control:Get()) end)
    return control
end

function Section:AddSlider(options)
    local w, t = self.Window, self.Window.Theme
    local minimum, maximum, step = options.Min or 0, options.Max or 100, options.Step or 1
    assert(maximum > minimum and step > 0, "Invalid slider range")
    local row = self:_row(options.Title or "Slider", 48)
    local valueText = text(row, "", { Size = UDim2.new(0, 65, 0, 28), Position = UDim2.new(1, -65, 0, 0), TextXAlignment = Enum.TextXAlignment.Right, TextSize = 17, TextColor3 = t.Accent })
    local hit = w:_button(row, "", { Size = UDim2.new(1, 0, 0, 20), Position = UDim2.fromOffset(0, 28), BackgroundTransparency = 1 })
    local track = new("Frame", { Size = UDim2.new(1, 0, 0, 4), Position = UDim2.fromOffset(0, 8), BackgroundColor3 = t.Raised }, hit)
    corner(track, 3)
    local fill = new("Frame", { Size = UDim2.fromScale(0, 1), BackgroundColor3 = t.Accent }, track)
    w:_accent(fill, "BackgroundColor3")
    w:_accent(valueText, "TextColor3")
    corner(fill, 3)
    local thumb = new("Frame", { Size = UDim2.fromOffset(10, 10), AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(1, 0.5), BackgroundColor3 = t.Text }, fill)
    corner(thumb, 10)
    local control = self:_control(options, options.Default or minimum, function(v)
        assert(type(v) == "number" and v == v and math.abs(v) < math.huge, "Slider expects finite number")
        return math.clamp(minimum + math.floor((math.clamp(v, minimum, maximum) - minimum) / step + 0.5) * step, minimum, maximum)
    end, function(value)
        fill.Size = UDim2.fromScale((value - minimum) / (maximum - minimum), 1)
        valueText.Text = string.format("%.4g%s", value, options.Suffix or "")
    end)
    local active
    local function update(input)
        local alpha = math.clamp((input.Position.X - track.AbsolutePosition.X) / math.max(1, track.AbsoluteSize.X), 0, 1)
        control:Set(minimum + alpha * (maximum - minimum))
    end
    w:_connect(hit.InputBegan, function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then active = input; update(input) end
    end)
    w:_connect(UIS.InputChanged, function(input)
        if active and (input == active or input.UserInputType == Enum.UserInputType.MouseMovement) then update(input) end
    end)
    w:_connect(UIS.InputEnded, function(input) if input == active then active = nil end end)
    return control
end

function Section:AddDropdown(options)
    local w, t = self.Window, self.Window.Theme
    local values = table.clone(options.Values or {})
    assert(#values > 0, "Dropdown needs Values")
    local row = self:_row(nil, 58)
    text(row, options.Title or "Dropdown", { Size = UDim2.new(1, 0, 0, 24), TextSize = 17 })
    local button = w:_button(row, "", { Position = UDim2.fromOffset(0, 26), TextSize = 17 })
    local choices = new("Frame", { Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, BackgroundTransparency = 1, Visible = false }, self.Content)
    list(choices, 3)
    -- Explicit order keeps expanded choices next to their owning dropdown.
    choices.LayoutOrder = row.LayoutOrder + 1
    local optionButtons = {}
    local control = self:_control(options, options.Default or values[1], function(v)
        assert(table.find(values, v), "Unknown dropdown value: " .. tostring(v)); return v
    end, function(value)
        button.Text = tostring(value) .. "   v"
        for name, item in pairs(optionButtons) do item.TextColor3 = name == value and t.Accent or t.Text end
    end)
    w:_connect(button.Activated, function() choices.Visible = not choices.Visible end)
    for _, value in ipairs(values) do
        local option = w:_button(choices, tostring(value), { TextSize = 17, BackgroundColor3 = t.Background, Size = UDim2.new(1, 0, 0, 26) })
        optionButtons[value] = option
        w:_accent(option, "TextColor3", function() return value == control:Get() and t.Accent or t.Text end)
        option.TextColor3 = value == control:Get() and t.Accent or t.Text
        w:_connect(option.Activated, function() control:Set(value); choices.Visible = false end)
    end
    return control
end

function Section:AddInput(options)
    local w, t = self.Window, self.Window.Theme
    local row = self:_row(nil, 58)
    text(row, options.Title or "Input", { Size = UDim2.new(1, 0, 0, 24), TextSize = 17 })
    local viewport = new("Frame", { Name = "InputViewport", Position = UDim2.fromOffset(0, 26), Size = UDim2.new(1, 0, 0, 30), BackgroundColor3 = t.Raised, ClipsDescendants = true }, row)
    corner(viewport, 3)
    local box = new("TextBox", { Position = UDim2.fromOffset(0, 0), Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1,
        TextColor3 = t.Text, PlaceholderColor3 = t.Muted, PlaceholderText = options.Placeholder or "Type here...",
        Text = "", TextSize = 17, Font = Enum.Font.Code, ClearTextOnFocus = false,
        ClipsDescendants = true, TextTruncate = Enum.TextTruncate.AtEnd, TextXAlignment = Enum.TextXAlignment.Left }, viewport)
    local inputPadding = Instance.new("UIPadding")
    inputPadding.PaddingLeft, inputPadding.PaddingRight = UDim.new(0, 8), UDim.new(0, 8)
    inputPadding.Parent = box
    local outline = stroke(viewport, t.Border)
    local control = self:_control(options, options.Default or "", function(v) assert(type(v) == "string", "Input expects string"); return v end, function(value) box.Text = value end)
    w:_connect(box.Focused, function() tween(outline, { Color = t.Accent }) end)
    w:_connect(box.FocusLost, function() tween(outline, { Color = t.Border }); control:Set(box.Text) end)
    control.TextBox, control.Viewport = box, viewport
    return control
end

function Section:AddKeybind(options)
    local w = self.Window
    local row = self:_row(options.Title or "Keybind")
    local button = w:_button(row, "", { Position = UDim2.new(1, -80, 0, 3), Size = UDim2.fromOffset(80, 24), TextSize = 12 })
    local control = self:_control(options, (options.Default or Enum.KeyCode.F).Name, function(v)
        if typeof(v) == "EnumItem" then v = v.Name end
        assert(type(v) == "string" and Enum.KeyCode[v] and v ~= "Unknown", "Invalid key code")
        return v
    end, function(value) button.Text = value end)
    w:_connect(button.Activated, function()
        if w.Capturing then return end
        w.Capturing = control
        button.Text = "..."
    end)
    w:_connect(UIS.InputBegan, function(input, processed)
        if w.Capturing == control then
            if input.KeyCode == Enum.KeyCode.Unknown then return end
            w.Capturing = nil
            w.LastCaptured = input
            task.defer(function() if w.LastCaptured == input then w.LastCaptured = nil end end)
            if input.KeyCode ~= Enum.KeyCode.Escape then control:Set(input.KeyCode.Name) else button.Text = control:Get() end
        elseif not w.Capturing and w.LastCaptured ~= input and not processed and not UIS:GetFocusedTextBox() and input.KeyCode.Name == control:Get() then
            invoke(options.OnPressed)
        end
    end)
    return control
end

function Section:AddButton(options)
    local w = self.Window
    local row = self:_row(nil, 32)
    local button = w:_button(row, options.Title or "Button")
    w:_connect(button.MouseEnter, function() tween(button, { BackgroundColor3 = w.Theme.Border }) end)
    w:_connect(button.MouseLeave, function() tween(button, { BackgroundColor3 = w.Theme.Raised }) end)
    w:_connect(button.Activated, function() invoke(options.Callback) end)
    return button
end

function Window:SetAccent(color)
    if type(color) == "string" then color = Color3.fromHex(color) end
    assert(typeof(color) == "Color3", "Accent expects Color3 or hex")
    self.Theme.Accent = color
    for _, target in ipairs(self.AccentTargets) do
        if target.Item.Parent then target.Item[target.Property] = target.Resolve and target.Resolve() or color end
    end
    self.BrandGradient.Color = ColorSequence.new({
        ColorSequenceKeypoint.new(0, color),
        ColorSequenceKeypoint.new(0.35, color:Lerp(Color3.fromRGB(170, 220, 255), 0.5)),
        ColorSequenceKeypoint.new(0.65, color:Lerp(Color3.fromRGB(255, 170, 220), 0.5)),
        ColorSequenceKeypoint.new(1, color),
    })
end

function Section:AddColorPicker(options)
    local w, t = self.Window, self.Window.Theme
    local row = self:_row(options.Title or "Color")
    local swatch = w:_button(row, "", { Position = UDim2.new(1, -42, 0, 5), Size = UDim2.fromOffset(42, 20) })
    local detail = new("Frame", { LayoutOrder = row.LayoutOrder + 1, Size = UDim2.new(1, 0, 0, 158), BackgroundTransparency = 1, Visible = options.Open ~= false }, self.Content)
    local sv = w:_button(detail, "", { Size = UDim2.new(1, -26, 0, 116), BackgroundColor3 = Color3.fromRGB(255, 0, 0) })
    local white = new("Frame", { Size = UDim2.fromScale(1, 1), BackgroundColor3 = Color3.fromRGB(255, 255, 255) }, sv)
    local saturation = Instance.new("UIGradient")
    saturation.Transparency = NumberSequence.new(0, 1)
    saturation.Parent = white
    local black = new("Frame", { Size = UDim2.fromScale(1, 1), BackgroundColor3 = Color3.fromRGB(0, 0, 0) }, sv)
    local valueGradient = Instance.new("UIGradient")
    valueGradient.Rotation, valueGradient.Transparency = 90, NumberSequence.new(1, 0)
    valueGradient.Parent = black
    local cursor = new("Frame", { Size = UDim2.fromOffset(8, 8), AnchorPoint = Vector2.new(0.5, 0.5), BackgroundTransparency = 1, ZIndex = 3 }, sv)
    corner(cursor, 8)
    stroke(cursor, Color3.fromRGB(255, 255, 255))
    local hue = w:_button(detail, "", { Position = UDim2.new(1, -16, 0, 0), Size = UDim2.fromOffset(16, 116), BackgroundColor3 = Color3.fromRGB(255, 255, 255) })
    local rainbow = Instance.new("UIGradient")
    local stops = {}
    for i = 0, 6 do table.insert(stops, ColorSequenceKeypoint.new(i / 6, Color3.fromHSV(i / 6, 1, 1))) end
    rainbow.Color, rainbow.Rotation = ColorSequence.new(stops), 90
    rainbow.Parent = hue
    local hueCursor = new("Frame", { Size = UDim2.new(1, 4, 0, 2), Position = UDim2.fromOffset(-2, 0), BackgroundColor3 = Color3.fromRGB(255, 255, 255), ZIndex = 3 }, hue)
    local hex = new("TextBox", { Position = UDim2.fromOffset(0, 126), Size = UDim2.new(1, 0, 0, 28), Text = "", TextSize = 17, ClearTextOnFocus = false, BackgroundColor3 = t.Raised, TextColor3 = t.Text }, detail)
    corner(hex, 3)
    local h, s, v = 0, 1, 1
    local config = table.clone(options)
    config.Callback = function(value) invoke(options.Callback, Color3.fromHex(value), value) end
    local control = self:_control(config, options.Default or t.Accent, function(value)
        if typeof(value) == "Color3" then return "#" .. value:ToHex():upper() end
        assert(type(value) == "string", "Color expects hex or Color3")
        value = value:gsub("^#", "")
        assert(#value == 6 and value:match("^%x+$"), "Use six hex digits")
        return "#" .. value:upper()
    end, function(value)
        local color = Color3.fromHex(value)
        h, s, v = color:ToHSV()
        swatch.BackgroundColor3 = color
        sv.BackgroundColor3 = Color3.fromHSV(h, 1, 1)
        cursor.Position = UDim2.fromScale(s, 1 - v)
        hueCursor.Position = UDim2.new(0, -2, h, 0)
        hex.Text = value
    end)
    control.Swatch, control.Hue, control.SaturationValue = swatch, hue, sv
    function control:GetColor() return Color3.fromHex(self:Get()) end
    w:_connect(swatch.Activated, function() detail.Visible = not detail.Visible end)
    w:_connect(hex.FocusLost, function()
        local ok = pcall(control.Set, control, hex.Text)
        if not ok then hex.Text = control:Get() end
    end)
    local active, mode
    local function update(input)
        if mode == "hue" then
            h = math.clamp((input.Position.Y - hue.AbsolutePosition.Y) / math.max(1, hue.AbsoluteSize.Y), 0, 0.9999)
        else
            s = math.clamp((input.Position.X - sv.AbsolutePosition.X) / math.max(1, sv.AbsoluteSize.X), 0, 1)
            v = 1 - math.clamp((input.Position.Y - sv.AbsolutePosition.Y) / math.max(1, sv.AbsoluteSize.Y), 0, 1)
        end
        control:Set(Color3.fromHSV(h, s, v))
    end
    for _, entry in ipairs({ { hue, "hue" }, { sv, "sv" } }) do
        w:_connect(entry[1].InputBegan, function(input)
            if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then active, mode = input, entry[2]; update(input) end
        end)
    end
    w:_connect(UIS.InputChanged, function(input) if active and (input == active or input.UserInputType == Enum.UserInputType.MouseMovement) then update(input) end end)
    w:_connect(UIS.InputEnded, function(input) if active and (input == active or input.UserInputType == active.UserInputType) then active = nil end end)
    return control
end

local function imageExtension(bytes)
    if bytes:sub(1, 8) == "\137PNG\13\10\26\10" then return "png" end
    if bytes:sub(1, 2) == "\255\216" then return "jpg" end
    if bytes:sub(1, 4) == "RIFF" and bytes:sub(9, 12) == "WEBP" then return "webp" end
    error("Image must be PNG, JPG or WebP")
end

function Window:_cacheBackground(bytes)
    assert(type(bytes) == "string" and #bytes <= 12 * 1024 * 1024, "Image exceeds 12 MB")
    assert(type(writefile) == "function" and type(getcustomasset) == "function", "Custom files unavailable in this client")
    local extension = imageExtension(bytes)
    if not isfolder("ShameHub") then makefolder("ShameHub") end
    if not isfolder("ShameHub/images") then makefolder("ShameHub/images") end
    local path = "ShameHub/images/" .. HttpService:GenerateGUID(false) .. "." .. extension
    writefile(path, bytes)
    return path
end

local function decodeBase64(value)
    local alphabet, lookup = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/", {}
    for i = 1, #alphabet do lookup[alphabet:sub(i, i)] = i - 1 end
    local output = {}
    for i = 1, #value, 4 do
        local a, b, c, d = value:sub(i, i), value:sub(i + 1, i + 1), value:sub(i + 2, i + 2), value:sub(i + 3, i + 3)
        local n = lookup[a] * 262144 + lookup[b] * 4096 + (lookup[c] or 0) * 64 + (lookup[d] or 0)
        local bytes = string.char(math.floor(n / 65536) % 256)
        if c ~= "=" then bytes = bytes .. string.char(math.floor(n / 256) % 256) end
        if d ~= "=" then bytes = bytes .. string.char(n % 256) end
        table.insert(output, bytes)
    end
    return table.concat(output)
end

function Window:SetBackground(source)
    self.BackgroundRequest = (self.BackgroundRequest or 0) + 1
    local requestId = self.BackgroundRequest
    local ok, image, stored = pcall(function()
        assert(type(source) == "string", "Background expects a path or URL")
        source = source:match("^%s*(.-)%s*$")
        if source == "" then return "", "" end
        if source == "default" then
            assert(type(getcustomasset) == "function" and type(writefile) == "function", "Default background requires custom file support")
            local path = "ShameHub/images/default-c35a1b35.png"
            if not isfolder("ShameHub") then makefolder("ShameHub") end
            if not isfolder("ShameHub/images") then makefolder("ShameHub/images") end
            if not isfile(path) then writefile(path, decodeBase64(DefaultBackgroundData)) end
            return getcustomasset(path), "default"
        end
        if source:match("^rbxassetid://%d+$") then return source, source end
        if source:match("^https?://") then
            local bytes = game:HttpGet(source)
            local host = source:match("^https?://([^/]+)"):lower()
            if host:match("pinterest%.[%a%.]+$") or host == "pin.it" then
                local url = bytes:match('<meta[^>]-property=["\']og:image["\'][^>]-content=["\'](.-)["\']')
                    or bytes:match('<meta[^>]-content=["\'](.-)["\'][^>]-property=["\']og:image["\']')
                assert(url, "Pinterest did not provide an image; use the direct i.pinimg.com URL")
                url = url:gsub("&amp;", "&"):gsub("&#x2F;", "/"):gsub("&#39;", "'")
                assert(url:match("^https?://"), "Invalid Pinterest image URL")
                bytes = game:HttpGet(url)
            end
            local path = self:_cacheBackground(bytes)
            return getcustomasset(path), path
        end
        assert(type(isfile) == "function" and isfile(source), "File not accessible. Use Choose local file or ShameHub/images/file.png")
        imageExtension(readfile(source))
        return getcustomasset(source), source
    end)
    if not ok then return false, tostring(image) end
    if self.Dead or self.BackgroundRequest ~= requestId then return false, "Background request superseded" end
    self.BackgroundImage.Image, self.BackgroundSource = image, stored
    self.BackgroundImage.Visible = image ~= ""
    for _, frame in ipairs(self.SurfaceFrames) do frame.BackgroundTransparency = image ~= "" and 0.15 or 0 end
    return true, stored
end

function Window:PickLocalBackground()
    local send = request or http_request or (syn and syn.request)
    if type(send) ~= "function" then return false, "HTTP request API unavailable" end
    local ok, response = pcall(send, { Url = "http://127.0.0.1:8767/pick", Method = "GET", Headers = { ["X-ShameHub-Local"] = "1" } })
    if not ok then return false, "Start LocalBackground.py on your PC, then try again" end
    if response.StatusCode == 204 then return false, "Selection cancelled" end
    if response.StatusCode ~= 200 then return false, "Local image picker failed" end
    local saved, path = pcall(self._cacheBackground, self, response.Body)
    if not saved then return false, tostring(path) end
    return self:SetBackground(path)
end

function Window:SetBackgroundOpacity(opacity)
    assert(type(opacity) == "number", "Opacity expects a number")
    self.BackgroundImage.ImageTransparency = 1 - math.clamp(opacity, 0, 1)
end

function Section:AddList(options)
    local w, t = self.Window, self.Window.Theme
    local values = table.clone(options.Values or {})
    local row = self:_row(nil, 66)
    text(row, options.Title or "List", { Size = UDim2.new(1, -36, 0, 24) })
    local count = text(row, "0", { Position = UDim2.new(1, -32, 0, 0), Size = UDim2.fromOffset(32, 24), TextSize = 12, TextColor3 = t.Muted, TextXAlignment = Enum.TextXAlignment.Right })
    local scroll = new("ScrollingFrame", {
        Position = UDim2.fromOffset(0, 28), Size = UDim2.new(1, 0, 1, -28), BackgroundColor3 = t.Background,
        AutomaticCanvasSize = Enum.AutomaticSize.Y, CanvasSize = UDim2.new(), ScrollBarThickness = 3,
        ScrollBarImageColor3 = t.Accent, ClipsDescendants = true,
    }, row)
    corner(scroll, 5)
    stroke(scroll, t.Border).Transparency = 0.5
    local padding = Instance.new("UIPadding")
    padding.PaddingTop, padding.PaddingBottom = UDim.new(0, 4), UDim.new(0, 4)
    padding.PaddingLeft, padding.PaddingRight = UDim.new(0, 4), UDim.new(0, 4)
    padding.Parent = scroll
    list(scroll, 4)
    local buttons, labels, markers, links = {}, {}, {}, {}
    local empty = text(scroll, "No saved configs", { Size = UDim2.new(1, -4, 0, 30), TextSize = 14, TextColor3 = t.Muted, TextXAlignment = Enum.TextXAlignment.Center })
    local control = self:_control(options, options.Default or "", function(value)
        assert(type(value) == "string" and (value == "" or table.find(values, value)), "Unknown list item")
        return value
    end, function(value)
        for name, button in pairs(buttons) do
            button.BackgroundColor3 = name == value and t.Raised or t.Background
            labels[name].TextColor3 = name == value and t.Accent or t.Muted
            markers[name].BackgroundColor3 = name == value and t.Accent or t.Muted
            markers[name].BackgroundTransparency = name == value and 0 or 0.65
        end
    end)
    function control:SetValues(nextValues, preferred)
        for _, link in ipairs(links) do link:Disconnect() end
        table.clear(links)
        for _, button in pairs(buttons) do button:Destroy() end
        table.clear(buttons)
        table.clear(labels)
        table.clear(markers)
        values = table.clone(nextValues)
        count.Text = tostring(#values)
        local height = math.min(options.Height or 140, math.max(38, #values * 30 + math.max(0, #values - 1) * 4 + 8))
        row.Size = UDim2.new(1, 0, 0, height + 28)
        scroll.ScrollBarThickness = (#values * 34 + 4 > height) and 3 or 0
        scroll.CanvasPosition = Vector2.new(0, 0)
        empty.Visible = #values == 0
        for _, name in ipairs(values) do
            local button = w:_button(scroll, "", { Size = UDim2.new(1, -4, 0, 30) })
            buttons[name] = button
            labels[name] = text(button, name, { Position = UDim2.fromOffset(24, 0), Size = UDim2.new(1, -32, 1, 0), TextSize = 15, TextTruncate = Enum.TextTruncate.AtEnd })
            markers[name] = new("Frame", { Position = UDim2.new(0, 11, 0.5, 0), AnchorPoint = Vector2.new(0.5, 0.5), Size = UDim2.fromOffset(5, 5), BackgroundColor3 = t.Muted }, button)
            corner(markers[name], 5)
            table.insert(links, button.Activated:Connect(function() control:Set(name) end))
            table.insert(links, button.MouseEnter:Connect(function() tween(button, { BackgroundColor3 = control:Get() == name and t.Raised or t.Panel }) end))
            table.insert(links, button.MouseLeave:Connect(function() tween(button, { BackgroundColor3 = control:Get() == name and t.Raised or t.Background }) end))
        end
        local selection = preferred or self:Get()
        if not table.find(values, selection) then selection = values[1] or "" end
        self:Set(selection)
    end
    w:_connect(scroll.Destroying, function() for _, link in ipairs(links) do link:Disconnect() end end)
    w:_accent(scroll, "ScrollBarImageColor3", function() control:Set(control:Get(), true); return t.Accent end)
    control:SetValues(values, options.Default)
    control.Scroll = scroll
    control.Row = row
    return control
end

local function configName(value)
    assert(type(value) == "string", "Enter a config name")
    value = value:match("^%s*(.-)%s*$")
    assert(#value > 0 and #value <= 96, "Config name must contain 1-96 bytes")
    assert(not value:find('[<>:"/\\|?*%c]') and value:sub(1, 1) ~= "." and value:sub(-1) ~= ".", "Invalid config name")
    local reserved = value:upper():match("^[^%.]+")
    assert(not ({CON=true,PRN=true,AUX=true,NUL=true})[reserved] and not reserved:match("^COM[1-9]$") and not reserved:match("^LPT[1-9]$"), "Reserved config name")
    return value
end

function Window:_prepareConfigs()
    assert(type(writefile) == "function" and type(readfile) == "function" and type(listfiles) == "function"
        and type(isfile) == "function" and type(isfolder) == "function" and type(makefolder) == "function", "This client does not provide file storage")
    local folder = self.ConfigFolder
    assert(folder ~= "" and not folder:match("^/") and not folder:find(":", 1, true), "ConfigFolder must be relative to the client workspace")
    local path = ""
    for part in folder:gmatch("[^/]+") do
        assert(part ~= "." and part ~= "..", "Invalid ConfigFolder")
        path = path == "" and part or path .. "/" .. part
        if not isfolder(path) then makefolder(path) end
    end
    return folder
end

function Window:ListConfigs()
    local ok, result = pcall(function()
        local folder, names = self:_prepareConfigs(), {}
        for _, file in ipairs(listfiles(folder)) do
            local name = file:gsub("\\", "/"):match("([^/]+)%.config$")
            if name and pcall(configName, name) then table.insert(names, name) end
        end
        table.sort(names, function(a, b) return a:lower() < b:lower() end)
        return names
    end)
    if ok then return result end
    return {}, tostring(result)
end

function Window:SaveConfig(name)
    local ok, err = pcall(function()
        name = configName(name)
        local folder = self:_prepareConfigs()
        writefile(folder .. "/" .. name .. ".config", HttpService:JSONEncode({Version=1, Values=self.Flags}))
    end)
    return ok, ok and name or tostring(err)
end

function Window:LoadConfig(name)
    local ok, err = pcall(function()
        name = configName(name)
        local path = self:_prepareConfigs() .. "/" .. name .. ".config"
        assert(isfile(path), "Config not found")
        local bytes = readfile(path)
        assert(#bytes <= 1024 * 1024, "Config exceeds 1 MB")
        local data = HttpService:JSONDecode(bytes)
        assert(type(data) == "table" and data.Version == 1 and type(data.Values) == "table", "Invalid config file")
        local success, errors = self:ImportConfig(HttpService:JSONEncode(data.Values))
        assert(success, errors)
        self.LoadedConfig = name
        invoke(self.ConfigLoaded, name)
    end)
    return ok, ok and name or tostring(err)
end

function Window:SetAutoloadConfig(name)
    local ok, err = pcall(function()
        name = configName(name)
        local folder = self:_prepareConfigs()
        assert(isfile(folder .. "/" .. name .. ".config"), "Save this config first")
        writefile(folder .. "/.autoload", name)
    end)
    return ok, ok and name or tostring(err)
end

function Window:GetAutoloadConfig()
    local ok, name = pcall(function()
        local path = self:_prepareConfigs() .. "/.autoload"
        if not isfile(path) then return nil end
        return configName(readfile(path))
    end)
    if ok then return name end
    return nil, tostring(name)
end

function Window:LoadAutoloadConfig()
    local name, err = self:GetAutoloadConfig()
    if not name then return false, err or "Autoload not set" end
    return self:LoadConfig(name)
end

function Window:ExportConfig()
    return HttpService:JSONEncode(self.Flags)
end

function Window:ImportConfig(json, silent)
    local ok, data = pcall(HttpService.JSONDecode, HttpService, json)
    if not ok or type(data) ~= "table" then return false, "Invalid JSON config" end
    local errors = {}
    for flag, value in pairs(data) do
        local control = self.Controls[flag]
        if control then
            local success, err = pcall(control.Set, control, value, silent)
            if not success then table.insert(errors, flag .. ": " .. tostring(err)) end
        end
    end
    return #errors == 0, table.concat(errors, "\n")
end

return ShameHub
