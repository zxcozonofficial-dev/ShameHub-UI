function Window:SetProfile(profile)
    assert(type(profile) == "table", "Profile expects a table")
    if not self.ProfileCard then return end
    for _, key in ipairs({"Name", "Subscription", "ExpiresIn", "Online"}) do
        if profile[key] ~= nil then self.ProfileData[key] = profile[key] end
    end
    local data = self.ProfileData
    local subscription = tostring(data.Subscription):gsub("&", "&amp;"):gsub("<", "&lt;"):gsub(">", "&gt;")
    self.ProfileName.Text = tostring(data.Name)
    self.ProfileSubscription.Text = '<font color="#' .. self.Theme.Muted:ToHex() .. '">Subscription:</font> ' .. subscription
    self.ProfileExpiry.Text = "Expires at: " .. tostring(data.ExpiresIn) .. " seconds"
    self.ProfileOnline.BackgroundColor3 = data.Online and Color3.fromRGB(35, 205, 120) or self.Theme.Muted
end

function Window:_createWatermark(options)
    self.WatermarkEnabled = options.Watermark ~= false
    self.GameName = "Place " .. tostring(game.PlaceId)
    self.WatermarkGui = Instance.new("ScreenGui")
    self.WatermarkGui.Name = self.Gui.Name .. "Watermark"
    self.WatermarkGui.IgnoreGuiInset = true
    self.WatermarkGui.ResetOnSpawn = false
    self.WatermarkGui.DisplayOrder = self.Gui.DisplayOrder
    self.WatermarkGui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
    self.WatermarkGui.Enabled = self.Gui.Enabled
    self.WatermarkGui.Parent = self.Gui.Parent
    self:_connect(self.Gui:GetPropertyChangedSignal("Enabled"), function() self.WatermarkGui.Enabled = self.Gui.Enabled end)
    self.Watermark = new("Frame", {
        Name = "Watermark", Position = options.WatermarkPosition or UDim2.new(0.5, 0, 0, 8),
        AnchorPoint = options.WatermarkAnchorPoint or (options.WatermarkPosition and Vector2.new(0, 0) or Vector2.new(0.5, 0)),
        Size = UDim2.fromOffset(380, 34), BackgroundColor3 = self.Theme.Background,
        BackgroundTransparency = 0.18, ClipsDescendants = true, Visible = false,
    }, self.WatermarkGui)
    corner(self.Watermark, 7)
    stroke(self.Watermark, self.Theme.Border)
    self.WatermarkScale = Instance.new("UIScale")
    self.WatermarkScale.Parent = self.Watermark
    local row = new("Frame", { Position = UDim2.fromOffset(12, 0), Size = UDim2.new(1, -24, 1, 0), BackgroundTransparency = 1 }, self.Watermark)
    local layout = list(row, 10, true)
    layout.VerticalAlignment = Enum.VerticalAlignment.Center
    self.WatermarkFields = {}
    local fields = { { "Brand" }, { "FPS", "Monitor" }, { "Ping", "Network" }, { "Game", "Gamepad" } }
    for index, field in ipairs(fields) do
        if index > 1 then
            new("Frame", { Size = UDim2.fromOffset(1, 14), BackgroundColor3 = self.Theme.Border }, row)
        end
        local group = new("Frame", { Name = field[1], Size = UDim2.fromOffset(0, 20), AutomaticSize = Enum.AutomaticSize.X, BackgroundTransparency = 1 }, row)
        local inner = list(group, 6, true)
        inner.VerticalAlignment = Enum.VerticalAlignment.Center
        if field[2] then drawIcon(group, field[2], self.Theme.Text) end
        self.WatermarkFields[field[1]] = text(group, "", {
            Size = UDim2.fromOffset(60, 20), TextSize = 14, TextColor3 = self.Theme.Text, TextTruncate = Enum.TextTruncate.AtEnd,
            TextYAlignment = Enum.TextYAlignment.Center,
        })
    end
    self.WatermarkLabel = self.WatermarkFields.Brand
    local updating = false
    self._RefreshWatermark = function()
        if self.Dead or updating then return end
        updating = true
        task.spawn(function()
            local pingOK, ping = pcall(function()
                return game:GetService("Stats").Network.ServerStatsItem["Data Ping"]:GetValue()
            end)
            local values = {
                Brand = options.WatermarkTitle or options.Title or "ShameHub",
                FPS = (self.FPS and tostring(math.floor(self.FPS + 0.5)) or "-") .. " FPS",
                Ping = (pingOK and type(ping) == "number" and tostring(math.floor(ping + 0.5)) or "-") .. " ms",
                Game = self.GameName,
            }
            local params = Instance.new("GetTextBoundsParams")
            params.Font, params.Size, params.Width = BoldFont, 14, 10000
            local widths = {}
            for name, value in pairs(values) do
                params.Text = value
                local ok, measured = pcall(TextService.GetTextBoundsAsync, TextService, params)
                widths[name] = ok and math.ceil(measured.X) + 1 or 100
            end
            params:Destroy()
            if not self.Dead then
                widths.Brand, widths.FPS, widths.Ping = math.min(160, widths.Brand), math.min(90, widths.FPS), math.min(80, widths.Ping)
                local fixed = 153 + widths.Brand + widths.FPS + widths.Ping
                widths.Game = math.min(widths.Game, 260, math.max(50, self.Gui.AbsoluteSize.X - 24 - fixed))
                for name, label in pairs(self.WatermarkFields) do
                    label.Text, label.Size = values[name], UDim2.fromOffset(widths[name], 20)
                end
                self.Watermark.Size = UDim2.fromOffset(fixed + widths.Game, 34)
                self.WatermarkScale.Scale = math.min(1, (self.Gui.AbsoluteSize.X - 24) / (fixed + widths.Game))
                self.WatermarkText = values.Brand .. " | " .. values.FPS .. " | " .. values.Ping .. " | " .. values.Game
            end
            updating = false
        end)
    end
    local frames, elapsed = 0, 0
    self:_connect(RunService.RenderStepped, function(delta)
        frames, elapsed = frames + 1, elapsed + delta
        if elapsed >= 1 then
            self.FPS = frames / elapsed
            frames, elapsed = 0, 0
            if self.Watermark.Visible then self._RefreshWatermark() end
        end
    end)
    self:_connect(self.Root:GetPropertyChangedSignal("Visible"), function()
        self.Watermark.Visible = self.WatermarkEnabled and not self.Root.Visible
        if self.Watermark.Visible then self._RefreshWatermark() end
    end)
    self:_connect(self.Gui:GetPropertyChangedSignal("AbsoluteSize"), self._RefreshWatermark)
    task.spawn(function()
        local ok, info = pcall(function()
            return game:GetService("MarketplaceService"):GetProductInfo(game.PlaceId, Enum.InfoType.Asset)
        end)
        if not self.Dead and ok and type(info) == "table" and type(info.Name) == "string" then
            self.GameName = info.Name
            self._RefreshWatermark()
        end
    end)
    self._RefreshWatermark()
end
function Window:SetMenuTransparency(value)
    assert(type(value) == "number" and value == value, "Transparency expects a number")
    self.MenuTransparency = math.clamp(value, 0, 0.7)
    self.Root.GroupTransparency = self.MenuTransparencyEnabled and self.MenuTransparency or 0
end

function Window:SetMenuTransparencyEnabled(enabled)
    assert(type(enabled) == "boolean", "Transparency enabled expects boolean")
    self.MenuTransparencyEnabled = enabled
    self.Root.GroupTransparency = enabled and self.MenuTransparency or 0
end

function Window:SetVersion(value)
    assert(type(value) == "string" or type(value) == "number", "Version expects string or number")
    self.Version = tostring(value)
    self.Status.Text = "ShameHub / Version " .. self.Version
end

function Window:SetToggleKey(value)
    if type(value) == "string" then value = Enum.KeyCode[value] end
    assert(typeof(value) == "EnumItem" and value.EnumType == Enum.KeyCode and value ~= Enum.KeyCode.Unknown, "Invalid menu key")
    self.ToggleKey = value
    self.MenuKeyLabel.Text = value.Name:upper() .. "  /  MENU"
end

function Window:SetStatus(value)
    self.LastStatus = tostring(value)
    invoke(self.StatusChanged, self.LastStatus)
end
function Window:Destroy()
    if self.Dead then return end
    self.Dead = true
    if self.BrandTween then self.BrandTween:Cancel() end
    for _, connection in ipairs(self.Connections) do connection:Disconnect() end
    table.clear(self.Connections)
    if self.WatermarkGui then self.WatermarkGui:Destroy() end
    self.Gui:Destroy()
end

function Window:AddPage(options)
