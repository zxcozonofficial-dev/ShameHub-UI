    tab.Line = new("Frame", { Position = UDim2.new(0, 7, 0.5, 0), AnchorPoint = Vector2.new(0.5, 0.5), Size = UDim2.fromOffset(4, 4), BackgroundColor3 = w.Theme.Accent, Visible = false }, tab.Button)
