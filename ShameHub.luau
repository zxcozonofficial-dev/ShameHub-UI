    frame.BackgroundTransparency = w.BackgroundImage.Visible and 0.15 or 0
    corner(frame, 3)
    stroke(frame, w.Theme.Border).Transparency = 0.55
    list(frame)
    local header = new("Frame", { Size = UDim2.new(1, 0, 0, 34), BackgroundTransparency = 1 }, frame)
    local sectionIcon = text(header, "●", { Position = UDim2.fromOffset(12, 0), Size = UDim2.fromOffset(18, 34), TextColor3 = w.Theme.Accent })
    w:_accent(sectionIcon, "TextColor3")
    text(header, options.Title or "General", { Position = UDim2.fromOffset(34, 0), Size = UDim2.new(1, -44, 1, 0), TextSize = 17, Font = Enum.Font.Code })
    new("Frame", { Position = UDim2.new(0, 0, 1, -1), Size = UDim2.new(1, 0, 0, 1), BackgroundColor3 = w.Theme.Border }, header)
    section.Content = new("Frame", { Size = UDim2.new(1, -24, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, BackgroundTransparency = 1 }, frame)
