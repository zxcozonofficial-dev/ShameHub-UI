local Players = game:GetService("Players")
local UIS = game:GetService("UserInputService")
local TweenService = game:GetService("TweenService")
local HttpService = game:GetService("HttpService")
local TextService = game:GetService("TextService")
local RunService = game:GetService("RunService")
local DefaultBackgroundData = ""
local function loadTypeface()
    local fallback = Font.new("rbxasset://fonts/families/BuilderSans.json", Enum.FontWeight.Bold)
    if type(getcustomasset) ~= "function" or type(writefile) ~= "function"
        or type(isfile) ~= "function" or type(makefolder) ~= "function" or type(isfolder) ~= "function" then
        return fallback, "Builder Sans Bold (fallback)"
    end
    local ok, font = pcall(function()
        if not isfolder("ShameHub") then makefolder("ShameHub") end
        local path = "ShameHub/Geist-Bold-1.9.0.ttf"
        if not isfile(path) then
            local bytes = game:HttpGet("https://cdn.jsdelivr.net/npm/geist@1.9.0/dist/fonts/geist-sans/Geist-Bold.ttf")
            assert(#bytes > 10000, "Invalid Geist font download")
            writefile(path, bytes)
        end
        local familyPath = "ShameHub/GeistSans.font.json"
        writefile(familyPath, HttpService:JSONEncode({ name = "Geist Sans", faces = {
            { name = "Bold", weight = 700, style = "normal", assetId = getcustomasset(path) },
        } }))
        local family = getcustomasset(familyPath)
        assert(TextService:GetFamilyInfoAsync(family).Name == "Geist Sans", "Geist family did not load")
        return Font.new(family, Enum.FontWeight.Bold)
    end)
    if ok then return font, "Geist Sans Bold" end
    warn("[ShameHub] Geist unavailable: " .. tostring(font))
    return fallback, "Builder Sans Bold (fallback)"
end
local BoldFont, TypefaceName = loadTypeface()

local IconAssets = {
    Version = "lucide-0.468.0-v2",
    BaseUrl = "https://raw.githubusercontent.com/zxcozonofficial-dev/ShameHub-UI/main/assets/icons/v2/",
    CacheFolder = "ShameHub/assets/icons/lucide-0.468.0-v2",
    Files = {
        Grid = "layout-grid.png", Settings = "settings.png", Info = "info.png", Layout = "panels-top-left.png",
        Palette = "palette.png", Keyboard = "keyboard.png", Folder = "folder.png", Book = "book-open.png",
        Monitor = "monitor.png", Network = "wifi.png", Gamepad = "gamepad-2.png",
    },
    Bytes = { Grid=1503, Settings=3043, Info=2591, Layout=1411, Palette=3299, Keyboard=1591, Folder=1354, Book=1537, Monitor=1232, Network=1886, Gamepad=2293 },
    Loaded = {}, Errors = {}, DownloadCount = 0, CacheHits = 0, Pending = 0,
}

local function prepareIcons()
    if not IconAssets.Started then
        IconAssets.Started = true
        if type(getcustomasset) ~= "function" or type(isfile) ~= "function" or type(readfile) ~= "function"
            or type(writefile) ~= "function" or type(isfolder) ~= "function" or type(makefolder) ~= "function" then
            IconAssets.Errors.Storage = "Custom asset storage unavailable"
            return false
        end
        local ok, err = pcall(function()
            local path = ""
            for part in IconAssets.CacheFolder:gmatch("[^/]+") do
                path = path == "" and part or path .. "/" .. part
                if not isfolder(path) then makefolder(path) end
            end
        end)
        if not ok then IconAssets.Errors.Storage = tostring(err); return false end
        for name, file in pairs(IconAssets.Files) do
            IconAssets.Pending = IconAssets.Pending + 1
            task.spawn(function()
                local success, result = pcall(function()
                    local path = IconAssets.CacheFolder .. "/" .. file
                    local cached = isfile(path) and readfile(path) or ""
                    if #cached == IconAssets.Bytes[name] and cached:sub(1, 8) == "\137PNG\13\10\26\10" then
                        IconAssets.CacheHits = IconAssets.CacheHits + 1
                    else
                        local send = request or http_request or (syn and syn.request)
                        local bytes
                        if type(send) == "function" then
                            local response = send({Url=IconAssets.BaseUrl .. file, Method="GET", Timeout=8})
                            assert(response.StatusCode == 200, "Icon download failed: " .. tostring(response.StatusCode))
                            bytes = response.Body
                        else bytes = game:HttpGet(IconAssets.BaseUrl .. file) end
                        assert(type(bytes) == "string" and #bytes == IconAssets.Bytes[name] and bytes:sub(1, 8) == "\137PNG\13\10\26\10", "Invalid icon PNG")
                        writefile(path, bytes)
                        IconAssets.DownloadCount = IconAssets.DownloadCount + 1
                    end
                    return getcustomasset(path)
                end)
                if success then IconAssets.Loaded[name] = result else IconAssets.Errors[name] = tostring(result) end
                IconAssets.Pending = IconAssets.Pending - 1
            end)
        end
    end
    local started = os.clock()
    while IconAssets.Pending > 0 and os.clock() - started < 10 do task.wait(0.03) end
    return IconAssets.Pending == 0 and next(IconAssets.Errors) == nil
end
prepareIcons()

local ShameHub = {}
ShameHub.Assets = IconAssets
ShameHub.PreloadIcons = prepareIcons
local Window, Page, Tab, Section = {}, {}, {}, {}
Window.__index, Page.__index, Tab.__index, Section.__index = Window, Page, Tab, Section

local palette = {
    Background = Color3.fromRGB(13, 13, 16),
    Sidebar = Color3.fromRGB(11, 11, 14),
    Panel = Color3.fromRGB(20, 20, 23),
    Raised = Color3.fromRGB(29, 29, 33),
    Border = Color3.fromRGB(32, 32, 37),
    Text = Color3.fromRGB(220, 220, 228),
    Muted = Color3.fromRGB(133, 133, 145),
    IconMuted = Color3.fromRGB(190, 190, 202),
    Accent = Color3.fromRGB(255, 255, 255),
}

local function new(class, props, parent)
    local item = Instance.new(class)
    item.BorderSizePixel = 0
    for key, value in pairs(props or {}) do item[key] = value end
    if item:IsA("TextLabel") or item:IsA("TextButton") or item:IsA("TextBox") then
        item.FontFace = BoldFont
    end
    item.Parent = parent
    return item
end

local function corner(parent, radius)
    local item = parent:FindFirstChildOfClass("UICorner") or Instance.new("UICorner")
    item.CornerRadius = UDim.new(0, radius or 5)
    item.Parent = parent
end

local function stroke(parent, color)
    local item = Instance.new("UIStroke")
    item.Color = color
    item.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
    item.Parent = parent
    return item
end

local function text(parent, value, props)
    local options = {
        BackgroundTransparency = 1, Text = value, TextSize = 17,
        Font = Enum.Font.Code, TextColor3 = palette.Text,
        TextXAlignment = Enum.TextXAlignment.Left, Size = UDim2.fromScale(1, 1),
    }
    for key, val in pairs(props or {}) do options[key] = val end
    return new("TextLabel", options, parent)
end

local function list(parent, gap, horizontal)
    local layout = Instance.new("UIListLayout")
    layout.Padding = UDim.new(0, gap or 0)
    layout.SortOrder = Enum.SortOrder.LayoutOrder
    layout.FillDirection = horizontal and Enum.FillDirection.Horizontal or Enum.FillDirection.Vertical
    layout.Parent = parent
    return layout
end

local function tween(item, props)
    TweenService:Create(item, TweenInfo.new(0.14, Enum.EasingStyle.Quad), props):Play()
end

local function invoke(callback, ...)
    if not callback then return end
    local ok, err = pcall(callback, ...)
    if not ok then warn("[ShameHub] " .. tostring(err)) end
end

function Window:_connect(signal, callback)
    local connection = signal:Connect(callback)
    table.insert(self.Connections, connection)
    return connection
end

function Window:_accent(item, property, resolve)
    table.insert(self.AccentTargets, { Item = item, Property = property, Resolve = resolve })
end

function Window:_button(parent, caption, props)
    local options = {
        Text = caption, Font = Enum.Font.Code, TextSize = 17,
        TextColor3 = self.Theme.Text, BackgroundColor3 = self.Theme.Raised,
        AutoButtonColor = false, Size = UDim2.new(1, 0, 0, 30),
    }
    for key, value in pairs(props or {}) do options[key] = value end
    local button = new("TextButton", options, parent)
    corner(button, 3)
    return button
end

function ShameHub.CreateWindow(options)
    options = options or {}
    assert(Players.LocalPlayer, "ShameHub must run on the client")
    local self = setmetatable({ Connections = {}, Pages = {}, Controls = {}, Flags = {}, AccentTargets = {}, Dead = false }, Window)
    self.Theme = table.clone(palette)
    self.Typeface = TypefaceName
    self.ConfigFolder = (options.ConfigFolder or ((options.ScriptFolder or "ShameHub") .. "/configs")):gsub("\\", "/"):gsub("/+$", "")
    for key, value in pairs(options.Theme or {}) do self.Theme[key] = value end
    local t = self.Theme
    self.ToggleKey = options.ToggleKey or Enum.KeyCode.RightShift
    self.Version = tostring(options.Version or "Dev")
    self.StatusChanged = options.OnStatus
    self.Gui = Instance.new("ScreenGui")
    self.Gui.Name = options.Name or "ShameHub"
    self.Gui.ResetOnSpawn = false
    self.Gui.IgnoreGuiInset = false
    self.Gui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
    self.Gui.DisplayOrder = options.DisplayOrder or 50
    self.Gui.Parent = options.Parent or Players.LocalPlayer:WaitForChild("PlayerGui")
    local width, height = 680, 440
    self.Root = new("CanvasGroup", {
        Size = UDim2.fromOffset(width, height), Position = UDim2.fromScale(0.5, 0.5),
        AnchorPoint = Vector2.new(0.5, 0.5), BackgroundColor3 = t.Background,
        ClipsDescendants = true, Active = true,
    }, self.Gui)
    self.BackgroundImage = new("ImageLabel", {
        Name = "BackgroundImage", Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1,
        Image = "", ImageTransparency = 0.65, ScaleType = Enum.ScaleType.Crop, Visible = false,
    }, self.Root)
    corner(self.BackgroundImage, 12)
    self.SurfaceFrames = {}
    corner(self.Root, 12)
    stroke(self.Root, t.Border)
    self.MenuTransparency = math.clamp(options.MenuTransparency or 0.25, 0, 0.7)
    self.MenuTransparencyEnabled = options.MenuTransparencyEnabled == true
    self.Root.GroupTransparency = self.MenuTransparencyEnabled and self.MenuTransparency or 0
    local scale = Instance.new("UIScale")
    scale.Parent = self.Root
    self.Scale = scale
    local bounds = new("Frame", { Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1 }, self.Gui)
    local function resize()
        local size = bounds.AbsoluteSize
        scale.Scale = math.max(0.1, math.min(1, (size.X - 24) / width, (size.Y - 24) / height))
        self.Root.Position = UDim2.fromScale(0.5, 0.5)
    end
    self:_connect(bounds:GetPropertyChangedSignal("AbsoluteSize"), resize)
    resize()
    local sidebar = new("Frame", { Size = UDim2.new(0, 132, 1, -25), BackgroundColor3 = t.Sidebar }, self.Root)
    self.Sidebar = sidebar
    table.insert(self.SurfaceFrames, sidebar)
    local titleText = options.Title or "ShameHub"
    local brandWidth = 124
    local measured, titleBounds = pcall(function()
        local params = Instance.new("GetTextBoundsParams")
        params.Text, params.Font, params.Size, params.Width = titleText, BoldFont, 22, 1000
        local result = TextService:GetTextBoundsAsync(params)
        params:Destroy()
        return result
    end)
    if measured then brandWidth = math.ceil(titleBounds.X) end
    self.TitleLabel = text(sidebar, titleText, {
        Position = UDim2.fromOffset(14, 16), Size = UDim2.fromOffset(brandWidth, 28),
        TextSize = 22, Font = Enum.Font.Code, TextColor3 = t.Accent,
    })
    self:_accent(self.TitleLabel, "TextColor3")
    local brandBar = new("Frame", {
        Name = "BrandBar", Position = UDim2.fromOffset(14, 47),
        Size = UDim2.fromOffset(brandWidth, 2), BackgroundColor3 = Color3.fromRGB(255, 255, 255),
    }, sidebar)
    self.BrandBar = brandBar
    corner(brandBar, 2)
    self.BrandGradient = Instance.new("UIGradient")
    self.BrandGradient.Color = ColorSequence.new({
        ColorSequenceKeypoint.new(0, t.Accent),
        ColorSequenceKeypoint.new(0.25, Color3.fromRGB(115, 175, 245)),
        ColorSequenceKeypoint.new(0.5, Color3.fromRGB(235, 180, 245)),
        ColorSequenceKeypoint.new(0.75, Color3.fromRGB(170, 125, 225)),
        ColorSequenceKeypoint.new(1, t.Accent),
    })
    self.BrandGradient.Offset = Vector2.new(-1, 0)
    self.BrandGradient.Parent = brandBar
    self.BrandTween = TweenService:Create(self.BrandGradient,
        TweenInfo.new(2.4, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut, -1, true),
        { Offset = Vector2.new(1, 0) })
    self.BrandTween:Play()
    text(sidebar, options.Subtitle or "INTERFACE LIBRARY", {
        Position = UDim2.fromOffset(14, 53), Size = UDim2.fromOffset(112, 20), TextSize = 12, TextColor3 = t.Muted,
    })
    self.Menu = new("ScrollingFrame", {
        Position = UDim2.fromOffset(8, 80), Size = UDim2.new(1, -16, 1, -92),
        BackgroundTransparency = 1, ScrollBarThickness = 2, ScrollBarImageColor3 = t.Accent,
        AutomaticCanvasSize = Enum.AutomaticSize.Y, CanvasSize = UDim2.new(),
    }, sidebar)
    list(self.Menu, 3)
    self:_accent(self.Menu, "ScrollBarImageColor3")
    self.Body = new("Frame", {
        Position = UDim2.fromOffset(140, 12), Size = UDim2.new(1, -152, 1, -49), BackgroundTransparency = 1,
    }, self.Root)
    self.FooterPanel = new("Frame", {
        Name = "FooterPanel", Position = UDim2.new(0, 0, 1, -26), Size = UDim2.new(1, 0, 0, 26),
        BackgroundColor3 = t.Background, BackgroundTransparency = 0, ZIndex = 4,
    }, self.Root)
    new("Frame", { Size = UDim2.new(1, 0, 0, 1), BackgroundColor3 = t.Border, ZIndex = 5 }, self.FooterPanel)
    self.Status = text(self.FooterPanel, "ShameHub / Version " .. self.Version, {
        Position = UDim2.fromOffset(12, 2), Size = UDim2.new(1, -175, 0, 23), TextSize = 12,
        TextColor3 = t.Text, TextTruncate = Enum.TextTruncate.AtEnd, ZIndex = 5,
    })
    self.MenuKeyLabel = text(self.FooterPanel, "RIGHT SHIFT  /  MENU", {
        Position = UDim2.new(1, -150, 0, 2), Size = UDim2.fromOffset(138, 23),
        TextXAlignment = Enum.TextXAlignment.Right, TextColor3 = t.Text, TextSize = 12, ZIndex = 5,
        Text = self.ToggleKey.Name:upper() .. "  /  MENU",
    })
    local drag = new("Frame", { Name = "DragRegion", Size = UDim2.new(1, 0, 0, 50), BackgroundTransparency = 1, Active = false, ZIndex = 0 }, self.Root)
    self.DragHandle = drag
    local dragInput, start, origin
    local function beginDrag(input)
        if input.UserInputType ~= Enum.UserInputType.MouseButton1 and input.UserInputType ~= Enum.UserInputType.Touch then return end
        if not self.Root.Visible or not self.Gui.Enabled then return end
        local point = Vector2.new(input.Position.X, input.Position.Y)
        local pos, size = drag.AbsolutePosition, drag.AbsoluteSize
        if point.X >= pos.X and point.X <= pos.X + size.X and point.Y >= pos.Y and point.Y <= pos.Y + size.Y then
            dragInput, start, origin = input, input.Position, self.Root.Position
        end
    end
    local function changeDrag(input)
        if dragInput and (input == dragInput or input.UserInputType == Enum.UserInputType.MouseMovement) then
            local delta = input.Position - start
            if math.abs(delta.X) < 3 and math.abs(delta.Y) < 3 then return end
            local size = bounds.AbsoluteSize
            local half = self.Root.AbsoluteSize / 2
            local x = origin.X.Scale * size.X + origin.X.Offset + delta.X
            local y = origin.Y.Scale * size.Y + origin.Y.Offset + delta.Y
            self.Root.Position = UDim2.fromOffset(math.clamp(x, half.X, math.max(half.X, size.X - half.X)), math.clamp(y, half.Y, math.max(half.Y, size.Y - half.Y)))
        end
    end
    local function endDrag(input)
        if dragInput and (input == dragInput or input.UserInputType == dragInput.UserInputType) then dragInput = nil end
    end
    self._DragHandlers = { Begin = beginDrag, Change = changeDrag, End = endDrag }
    self:_connect(UIS.InputBegan, beginDrag)
    self:_connect(UIS.InputChanged, changeDrag)
    self:_connect(UIS.InputEnded, endDrag)
    self:_connect(UIS.InputBegan, function(input, processed)
        if not UIS:GetFocusedTextBox() and not self.Capturing and self.LastCaptured ~= input and input.KeyCode == self.ToggleKey then
            self:SetVisible(not self.Root.Visible)
        end
    end)
    self:_connect(self.Gui.Destroying, function() self:Destroy() end)
    self:SetBackground(options.Background == nil and "default" or options.Background)
    if options.Profile ~= false then self:_createProfileCard(options.Profile or {}) end
    self:_createWatermark(options)
    return self
end

function Window:SetVisible(visible)
    self.Root.Visible = visible
    if self.Watermark then
        self.Watermark.Visible = self.WatermarkEnabled and not visible
        if self.Watermark.Visible then self._RefreshWatermark() end
    end
    if self.BrandTween then
        if visible then self.BrandTween:Play() else self.BrandTween:Pause() end
    end
end

local function drawIcon(parent, kind, color)
    if type(kind) == "string" and kind:match("^rbxasset") then
        return new("ImageLabel", { Name = "MenuIcon", Size = UDim2.fromOffset(16, 16), BackgroundTransparency = 1, Image = kind, ImageColor3 = color, ScaleType = Enum.ScaleType.Fit }, parent)
    end
    local asset = IconAssets.Loaded[kind] or (not IconAssets.Files[kind] and IconAssets.Loaded.Grid)
    if asset then
        return new("ImageLabel", { Name = kind .. "Icon", Size = UDim2.fromOffset(16, 16), BackgroundTransparency = 1,
            Image = asset, ImageColor3 = color, ScaleType = Enum.ScaleType.Fit, ResampleMode = Enum.ResamplerMode.Default }, parent)
    end
    local icon = new("Frame", { Name = kind .. "Icon", Size = UDim2.fromOffset(16, 16), BackgroundTransparency = 1 }, parent)
    local function block(x, y, width, height)
        return new("Frame", { Position = UDim2.fromOffset(x, y), Size = UDim2.fromOffset(width, height), BackgroundColor3 = color }, icon)
    end
    if kind == "Monitor" then
        local screen = block(1, 1, 14, 9)
        screen.BackgroundTransparency = 1
        corner(screen, 2)
        stroke(screen, color)
        block(7, 11, 2, 2)
        block(4, 14, 8, 1)
    elseif kind == "Network" then
        for i = 0, 2 do corner(block(2 + i * 5, 10 - i * 4, 3, 4 + i * 4), 1) end
    elseif kind == "Gamepad" then
        local body = block(0, 4, 16, 10)
        body.BackgroundTransparency = 1
        corner(body, 3)
        stroke(body, color)
        block(2, 8, 5, 1)
        block(4, 6, 1, 5)
        corner(block(11, 7, 2, 2), 2)
        corner(block(13, 10, 2, 2), 2)
        block(3, 2, 3, 1)
        block(10, 2, 3, 1)
    elseif kind == "Settings" then
        local ring = block(3, 3, 10, 10)
        ring.BackgroundTransparency = 1
        corner(ring, 10)
        stroke(ring, color)
        local center = block(6, 6, 4, 4)
        center.BackgroundTransparency = 1
        corner(center, 4)
        stroke(center, color)
        for i = 0, 7 do
            local angle = math.rad(i * 45)
            local tooth = block(8 + math.cos(angle) * 6.5, 8 + math.sin(angle) * 6.5, 3, 2)
            tooth.AnchorPoint = Vector2.new(0.5, 0.5)
            tooth.Rotation = i * 45
        end
    elseif kind == "Info" then
        local ring = block(1, 1, 14, 14)
        ring.BackgroundTransparency = 1
        corner(ring, 14)
        stroke(ring, color)
        corner(block(7, 4, 2, 2), 2)
        corner(block(7, 8, 2, 4), 1)
    elseif kind == "Palette" then
        local ring = block(1, 1, 14, 14)
        ring.BackgroundTransparency = 1
        corner(ring, 14)
        stroke(ring, color)
        for _, point in ipairs({{5,4},{10,4},{3,9},{8,10}}) do corner(block(point[1],point[2],2,2),2) end
    elseif kind == "Keyboard" then
        local body = block(0, 3, 16, 11)
        body.BackgroundTransparency = 1
        corner(body, 2)
        stroke(body, color)
        for x = 3, 12, 3 do block(x, 6, 1, 1); block(x, 9, 1, 1) end
        block(5, 12, 6, 1)
    elseif kind == "Folder" then
        local body = block(1, 5, 14, 9)
        body.BackgroundTransparency = 1
        corner(body, 2)
        stroke(body, color)
        block(2, 2, 5, 2)
        block(1, 3, 1, 3)
    elseif kind == "Book" then
        for _, x in ipairs({1,9}) do
            local page = block(x, 2, 6, 12)
            page.BackgroundTransparency = 1
            corner(page, 1)
            stroke(page, color)
        end
        block(8, 3, 1, 12)
    elseif kind == "Layout" then
        local body = block(1, 1, 14, 14)
        body.BackgroundTransparency = 1
        corner(body, 2)
        stroke(body, color)
        block(2, 5, 12, 1)
        block(6, 6, 1, 8)
    else
        for _, point in ipairs({{1,1},{9,1},{1,9},{9,9}}) do
            local cell = block(point[1], point[2], 6, 6)
            cell.BackgroundTransparency = 1
            corner(cell, 1)
            stroke(cell, color)
        end
    end
    return icon
end

local function paintIcon(icon, color)
    if not icon then return end
    if icon:IsA("ImageLabel") then icon.ImageColor3 = color end
    for _, item in ipairs(icon:GetDescendants()) do
        if item:IsA("UIStroke") then item.Color = color
        elseif item:IsA("Frame") and item.BackgroundTransparency < 1 then item.BackgroundColor3 = color end
    end
end

function Window:_registerIcon(icon, resolve)
    if icon:IsA("ImageLabel") then self:_accent(icon, "ImageColor3", resolve) end
    for _, item in ipairs(icon:GetDescendants()) do
        if item:IsA("UIStroke") then self:_accent(item, "Color", resolve)
        elseif item:IsA("Frame") and item.BackgroundTransparency < 1 then self:_accent(item, "BackgroundColor3", resolve) end
    end
end

